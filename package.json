{
  "name": "oxc-remove-attributes",
  "version": "0.2.0",
  "description": "Vite/Rolldown plugin that strips JSX attributes (e.g. data-testid) from production builds using oxc + magic-string. Covers the @swc/plugin-react-remove-properties use case on Vite 8 / @vitejs/plugin-react (oxc), with exact attribute names instead of regex patterns.",
  "keywords": [
    "data-testid",
    "jsx",
    "oxc",
    "production",
    "react",
    "remove-attributes",
    "rolldown",
    "rolldown-plugin",
    "strip-attributes",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/0x31/oxc-remove-attributes#readme",
  "bugs": {
    "url": "https://github.com/0x31/oxc-remove-attributes/issues"
  },
  "license": "ISC",
  "author": "0x31",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x31/oxc-remove-attributes.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "yarn build && cd integration-test && touch yarn.lock && yarn install --no-immutable && yarn test",
    "build": "rimraf ./dist && tsgo --project tsconfig.build.json",
    "lint": "oxlint --ignore-pattern integration-test",
    "lint:fix": "yarn lint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo",
    "prepublishOnly": "yarn lint && yarn format:check && yarn typecheck && yarn test:run && yarn build && yarn test:integration"
  },
  "dependencies": {
    "magic-string": "^1.4.1",
    "oxc-parser": "^0.151.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@types/node": "^26.6.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "yarn@4.7.0"
}
